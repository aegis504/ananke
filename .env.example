# Client-side (VITE_ prefix = exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Build-time/Server-side secrets
# Add these to GitHub Secrets and Vercel Env Vars
FEATHERLESS_API_KEY_1=your-featherless-api-key-1
FEATHERLESS_API_KEY_2=your-featherless-api-key-2
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
